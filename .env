# ═══════════════════════════════════════════════════════
# BINANCE FUTURES ANALYZER — CẤU HÌNH
# ═══════════════════════════════════════════════════════
# Copy file này thành .env và điền thông tin

# ── Chế độ dữ liệu ──────────────────────────────────
# "public" : Dùng Public API, không cần key (Mặc định)
# "api"    : Dùng CCXT với API Key cá nhân
DATA_MODE=public

# ── API Key (Chỉ cần khi DATA_MODE=api) ─────────────
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ── Testnet (true/false) ─────────────────────────────
# true  → Dùng Binance Testnet (an toàn để test)
# false → Dùng Binance thật (Mặc định)
BINANCE_TESTNET=false

# ── Telegram Bot ─────────────────────────
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=8966337923:AAEomMwKVB0bnFkNcPjchIYgfm1E0Zo7ja0

# ID admin (để nhận thông báo lỗi)
# Lấy ID bằng cách nhắn tin @userinfobot
TELEGRAM_ADMIN_ID=393504616